# AI Provider API Keys (focus: OpenAI + Cerebras routing)
# OpenAI: https://platform.openai.com/api-keys
# Cerebras (OpenAI-compatible endpoint): https://www.cerebras.ai (obtain key via Cerebras Cloud)

# Primary OpenAI key (used by OpenAI Dev Tools and Vercel AI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Route OpenAI traffic via a custom base URL (e.g., Cerebras OpenAI-compatible endpoint)
# Example: OPENAI_BASE_URL=https://api.cerebras.ai/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional, used by Vercel AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration
DEV_CONSOLE_PORT=8090
DEV_CONSOLE_HOST=0.0.0.0
DEV_CONSOLE_LOG_FILE=./console-logs.json
DEV_CONSOLE_TOKEN=your_auth_token_here
DEV_CONSOLE_ORIGIN=http://localhost:3000
